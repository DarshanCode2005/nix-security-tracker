flowchart LR
    Users[Users]

    subgraph web [Web]
        Nginx[Nginx]
        DjangoAsgi["Daphne ASGI Django"]
    end

    subgraph jobs [Scheduled Commands]
        IngestDelta["ingest_delta_cve (03:00 daily)"]
        FetchChannels["fetch_all_channels (04:00 daily)"]
        GarbageCollect["garbage_collect (Fri 20:00)"]
    end

    subgraph workers [Background Workers]
        Worker["pgpubsub worker"]
        Evaluator["pgpubsub evaluator"]
    end

    subgraph storage [Storage]
        Postgres[(PostgreSQL)]
        NixpkgsRepo["local nixpkgs checkout"]
        CveCache["cve cache"]
        NixStore["/nix/store"]
    end

    subgraph external [External Services]
        GitHubApi[GitHub API]
        GitHubCve["CVEProject/cvelistV5"]
        GitHubNixpkgs["nixos/nixpkgs"]
        MonitoringApi["monitoring.nixos.org"]
    end

    Users --> Nginx --> DjangoAsgi --> Postgres
    DjangoAsgi --> GitHubApi

    IngestDelta --> GitHubCve
    IngestDelta --> CveCache
    IngestDelta --> Postgres

    FetchChannels --> MonitoringApi
    FetchChannels --> GitHubNixpkgs
    FetchChannels --> NixpkgsRepo
    FetchChannels --> Postgres

    Postgres <-->|"NOTIFY/LISTEN"| Worker
    Postgres <-->|"NOTIFY/LISTEN"| Evaluator
    Evaluator --> NixpkgsRepo
    Evaluator --> NixStore
    GarbageCollect --> Postgres
